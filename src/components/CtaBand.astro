---
interface Props { heading?: string; body?: string; primary?: { href: string; label: string }; secondary?: { href: string; label: string } }
const {
  heading = "Put your site on Autopilot",
  body = "Start with a free review. We go through your whole site once and send you a plain list of what we would fix and why — whether or not you ever buy anything.",
  primary = { href: "/contact/", label: "Book a free review" },
  secondary = { href: "/pricing/", label: "See pricing" },
} = Astro.props;
---
<section class="band invert">
  <div class="wrap inner">
    <div>
      <h2>{heading}</h2>
      <p class="lede">{body}</p>
    </div>
    <div class="actions">
      <a class="btn btn--primary" href={primary.href}>{primary.label}</a>
      <a class="btn btn--ghost" href={secondary.href}>{secondary.label}</a>
    </div>
  </div>
</section>

<style>
  /* This band holds two short lines and two buttons. A full --section of padding
     top and bottom made it taller than its own content, so it gets its own scale. */
  .band { padding-block: clamp(2.75rem, 2rem + 3vw, 4.5rem); }
  .inner { display: grid; gap: 1.75rem; align-items: center; }
  @media (min-width: 900px) { .inner { grid-template-columns: 1.4fr auto; gap: 3rem; } }
  h2 { max-width: 16ch; margin-bottom: 1rem; }
  .actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }
</style>
