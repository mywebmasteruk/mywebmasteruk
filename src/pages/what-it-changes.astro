---
import Base from "~/layouts/Base.astro";
import CtaBand from "~/components/CtaBand.astro";
import { getCollection } from "astro:content";
import { site } from "~/data/site";

const caps = (await getCollection("capabilities")).sort((a, b) =>
  a.data.category.localeCompare(b.data.category),
);
const categories = [...new Set(caps.map((c) => c.data.category))];
// Counts describe what is running today. A capability we have not finished is
// still listed in the table below, marked as such, rather than quietly counted
// as though it were working.
const live = caps.filter((c) => c.data.status !== "planned");
const planned = caps.filter((c) => c.data.status === "planned");
const counts = {
  auto: live.filter((c) => c.data.autonomy === "auto").length,
  notify: live.filter((c) => c.data.autonomy === "notify").length,
  never: live.filter((c) => c.data.autonomy === "never").length,
};
const autonomyLabel: Record<string, string> = {
  auto: "We just do it",
  notify: "We do it, then tell you the same day",
  never: "Never",
};
const reversibleLabel: Record<string, string> = {
  instant: "Undone instantly",
  commit: "Undone in one step",
  manual: "Not applicable",
};
---
<Base
  title="What Autopilot changes — and what it never touches"
  description="The full change taxonomy: which changes ship unattended, which need human approval, and which are permanently out of bounds. Published so clients can hold us to it."
  breadcrumbs={[{ name: "What it changes", href: "/what-it-changes/" }]}
>
  <section class="section head">
    <div class="wrap">
      <p class="label">The boundary</p>
      <h1>The full list. Including the things it is never allowed to touch.</h1>
      <p class="lede">
        Letting something automatic change your live website is only sensible if the limits are
        specific, enforced by the system itself, and published where you can hold us to them.
        These are ours. If a change is not on this list, Autopilot cannot make it.
      </p>
      <div class="summary">
        <div class="sum sum--auto"><span class="n">{counts.auto}</span> we do ourselves</div>
        <div class="sum sum--notify"><span class="n">{counts.notify}</span> we do, then email you the same day</div>
        <div class="sum sum--never"><span class="n">{counts.never}</span> never happen</div>
      </div>
    </div>
  </section>

  <section class="wrap">
    {categories.map((cat) => (
      <div class="cat">
        <h2>{cat}</h2>
        <div class="table-scroll">
          <table>
            <caption class="visually-hidden">{cat} changes and their autonomy levels</caption>
            <thead>
              <tr>
                <th scope="col">What can change</th>
                <th scope="col">Who decides</th>
                <th scope="col">Undoing it</th>
                <th scope="col">What sets it off</th>
              </tr>
            </thead>
            <tbody>
              {caps.filter((c) => c.data.category === cat).map((c) => (
                <tr>
                  <th scope="row">
                    {c.data.change}
                    {c.data.status === "planned" && <span class="tag tag--planned">Not built yet</span>}
                    <span class="why">{c.data.why}</span>
                  </th>
                  <td><span class={`tag tag--${c.data.autonomy}`}>{autonomyLabel[c.data.autonomy]}</span></td>
                  <td class="mono nowrap">{reversibleLabel[c.data.reversible]}</td>
                  <td class="muted">{c.data.signal}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    ))}
  </section>

  <section class="section note">
    <div class="wrap wrap--narrow">
      <h2>Why the "never" list matters more than the rest</h2>
      <p>Two things are locked permanently, and no plan unlocks them.</p>
      <p>
        The first is anything that says what you charge or what you promise. Something automatic
        that could change a price or a guarantee could commit you to a deal you never agreed to.
        Those words are sealed off, and an attempt to edit them stops the change going live at all.
      </p>
      <p>
        The second is the handful of settings that tell Google whether it is allowed to show your
        site. One wrong setting there can take your entire website out of Google, and you would
        not notice for weeks — by which time the damage is done. Nothing automatic should be
        trusted with that, however confident it is, so a person keeps hold of it permanently.
      </p>
    </div>
  </section>

  <CtaBand
    heading="Think a line is in the wrong place?"
    body="We can move most of them for you — tighter or looser, whichever you prefer. Nobody has yet asked us to unlock the never list."
  />
</Base>

<style>
  .head h1 { margin-block: 1rem 1.2rem; max-width: 20ch; }
  .summary { display: flex; flex-wrap: wrap; gap: 1.5rem 2.5rem; margin-top: 2.5rem; font-size: var(--step--1); }
  .sum { display: flex; align-items: baseline; gap: 0.5rem; }
  .sum .n { font-size: var(--step-2); font-weight: 600; font-variant-numeric: tabular-nums; }
  .sum--auto .n { color: var(--ok-text); }
  .sum--notify .n { color: var(--warn-text); }
  .sum--never .n { color: var(--bad-text); }

  .cat { margin-top: var(--section); }
  .cat h2 { font-size: var(--step-2); margin-bottom: 1.2rem; }
  table { border-top: 1px solid var(--line-strong); min-width: 720px; }
  th[scope="row"] { font-weight: 600; max-width: 30ch; }
  .why { display: block; font-weight: 400; color: var(--text-muted); font-size: 0.82em; margin-top: 0.35rem; line-height: 1.45; }
  .nowrap { white-space: nowrap; }
  .tag { display: inline-block; font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.08em; text-transform: uppercase; padding: 0.25rem 0.55rem; border-radius: 100px; border: 1px solid; white-space: nowrap; }
  .tag--auto { color: var(--ok-text); border-color: var(--ok-text); }
  .tag--notify { color: var(--warn-text); border-color: var(--warn-text); }
  .tag--never { color: var(--bad-text); border-color: var(--bad-text); }
  .tag--planned { color: var(--muted); border-color: var(--line-strong); margin-left: 0.5rem; }
  .note h2 { font-size: var(--step-3); margin-bottom: 1.2rem; }
  .note p + p { margin-top: 1rem; }
  .note p { max-width: 68ch; }
  code { font-family: var(--font-mono); font-size: 0.88em; background: var(--bg-soft); padding: 0.1em 0.35em; border-radius: 3px; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>
