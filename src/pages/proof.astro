---
import Base from "~/layouts/Base.astro";
import Readout from "~/components/Readout.astro";
import CtaBand from "~/components/CtaBand.astro";
import experiment from "~/data/experiment.json";
import performance from "~/data/performance.json";
import { getCollection } from "astro:content";
import { site } from "~/data/site";

const entries = (await getCollection("changelog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const fmt = new Intl.NumberFormat("en-GB");
const opps = experiment.topOpportunities;

/**
 * What kind of claim this page is allowed to make.
 *
 * The method below used to be hard-coded prose describing a randomised control —
 * on a site that has never run one. That is the worst place on the site to be
 * describing something we do not do, so the steps are rendered from the data that
 * says what we actually do. A missing `design` reads as "none", never as proof.
 */
const design = experiment.design ?? { kind: "none", holdout: null, note: "" };
const controlled = design.kind === "controlled" && Array.isArray(design.holdout) && design.holdout.length > 0;

const steps = [
  {
    n: "01",
    h: "Post the starting numbers first",
    p: "Written down before a single change is made. That removes the oldest trick in the trade: quietly choosing a flattering start date once you already know how it turned out.",
  },
  controlled
    ? {
        n: "02",
        h: "Leave some pages alone",
        p: `Similar pages are split into two groups, and ${design.holdout.length} of them are deliberately never improved. That genuinely costs something — and it is what buys you a number you can trust.`,
      }
    : {
        n: "02",
        h: "Say what the number cannot tell you",
        p: design.note || "No pages are being held back as a comparison on this site, so a result here cannot be separated from whatever the market did that month.",
      },
  {
    n: "03",
    h: "Agree the timescale up front",
    p: "28 days, decided in advance, with the page left untouched throughout. Anything shorter is measuring noise. Anything decided afterwards is measuring wishful thinking.",
  },
  controlled
    ? {
        n: "04",
        h: "Report the difference, losses and all",
        p: "How the improved pages moved, minus how the untouched ones moved. Anything that lost gets put back, and published just as visibly as anything that won.",
      }
    : {
        n: "04",
        h: "Report the movement, losses and all",
        p: "How the changed pages moved, before against after, with no claim that we caused it. Anything that lost gets put back, and published just as visibly as anything that won.",
      },
];
---
<Base
  title="Proof & method — the experiment running on this domain"
  description="The measurement method behind Autopilot: the published baseline, what the numbers can and cannot show, the agreed window, and what gets reported — including losses."
  breadcrumbs={[{ name: "Proof", href: "/proof/" }]}
>
  <section class="section head">
    <div class="wrap">
      <p class="label">Proof &amp; method</p>
      <h1>The experiment is this website.</h1>
      <p class="lede">
        It would be a bit rich to sell a service that improves websites automatically, using a
        website we polished by hand. So this one is the guinea pig: same system, same rules, same
        public record — and we posted the starting numbers before doing any of the work.
      </p>
    </div>
  </section>

  <section class="wrap">
    <Readout />
  </section>

  <section class="section">
    <div class="wrap wrap--narrow prose">
      <h2>What the baseline says</h2>
      <p>
        In the 90 days to {experiment.baseline.window.endDate}, this website appeared in Google
        {fmt.format(experiment.baseline.impressions)} times and got
        {experiment.baseline.clicks} visits from it. That is roughly one visit for every seven
        hundred times we were shown, sitting on average around page four.
      </p>
      <p>
        Sitting around page four means Google knows the site exists and thinks it is roughly
        relevant, but nobody scrolls that far. Those eighteen thousand appearances are real
        people looking for something we could have helped with. That is a better starting point
        than no interest at all, because the demand is already there — it just is not being met.
      </p>

      <h2>The demand that is already arriving</h2>
      <p>
        These are the searches where this site gets shown but almost never clicked. Look at what
        they have in common: they are all describing the exact problem Autopilot exists to fix.
      </p>
    </div>
  </section>

  <section class="wrap">
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th scope="col">What people searched for</th>
            <th scope="col">Times shown</th>
            <th scope="col">Visits</th>
            <th scope="col">Click rate</th>
            <th scope="col">Typical spot</th>
          </tr>
        </thead>
        <tbody>
          {opps.map((o) => (
            <tr>
              <th scope="row">{o.query}</th>
              <td class="num">{fmt.format(o.impressions)}</td>
              <td class="num">{o.clicks}</td>
              <td class="num">{o.ctr}%</td>
              <td class="num">{o.position}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mono muted src">
      Source: Google's own search figures for this website, {experiment.baseline.window.startDate}
      to {experiment.baseline.window.endDate}.
    </p>
  </section>

  <section class="section speed">
    <div class="wrap">
      <p class="label">Speed, published</p>
      <h2>How fast this site actually is.</h2>
      <p class="lede">
        A service that sells page speed should show its own. These are updated
        automatically, and they include the number we cannot report yet.
      </p>

      <div class="grid grid--4 shipped">
        <div class="card">
          <p class="mono k">Code sent to your browser</p>
          <p class="v">{(performance.build.totalJsBytes / 1024).toFixed(1)}<span>KB</span></p>
          <p class="mono muted">A typical site ships 300KB to 2MB</p>
        </div>
        <div class="card">
          <p class="mono k">Heaviest page</p>
          <p class="v">{(performance.build.largestPage.bytes / 1024).toFixed(0)}<span>KB</span></p>
          <p class="mono muted">{performance.build.largestPage.path}</p>
        </div>
        <div class="card">
          <p class="mono k">Fonts</p>
          <p class="v">{(performance.build.fontBytes / 1024).toFixed(0)}<span>KB</span></p>
          <p class="mono muted">One file, served from this site</p>
        </div>
        <div class="card">
          <p class="mono k">Other companies' code loading first</p>
          <p class="v">{performance.build.thirdPartyOnCriticalPath}</p>
          <p class="mono muted">Nothing blocks the page appearing</p>
        </div>
      </div>

      {performance.results.length > 0 && (
        <div class="table-scroll lighthouse">
          <table>
            <thead>
              <tr>
                <th scope="col">Google's test</th>
                <th scope="col">Speed</th>
                <th scope="col">Accessibility</th>
                <th scope="col">Good practice</th>
                <th scope="col">Search readiness</th>
              </tr>
            </thead>
            <tbody>
              {performance.results.map((r) => (
                <tr>
                  <th scope="row">{r.strategy === "mobile" ? "On a phone" : "On a desktop"}</th>
                  <td class="num">{r.lab.performance}</td>
                  <td class="num">{r.lab.accessibility}</td>
                  <td class="num">{r.lab.bestPractices}</td>
                  <td class="num">{r.lab.seo}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

      <div class="field-note">
        <p class="label">The number we cannot show you yet</p>
        {performance.fieldDataAvailable ? (
          <p>
            Google now has enough real visits to this site to report what actual people
            experience, and those figures are included above.
          </p>
        ) : (
          <p>
            Everything above is a test, not a measurement. The figures Google actually grades
            you on come from real visitors on real phones, and Google only reports them once a
            site has enough traffic. This one does not yet — which is exactly what you would
            expect from a site that got {experiment.baseline.clicks} visits in 90 days.
            When there is enough traffic to report, those numbers appear here, whatever they say.
          </p>
        )}
        <p class="mono muted">
          Last measured {new Date(performance.measuredAt).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" })}
        </p>
      </div>
    </div>
  </section>

  <section class="section method invert">
    <div class="wrap">
      <p class="label">Method</p>
      <h2>How we decide something actually worked</h2>
      <div class="grid grid--2 steps">
        {steps.map((step) => (
          <div class="card">
            <p class="mono n">{step.n}</p>
            <h3>{step.h}</h3>
            <p class="muted">{step.p}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap wrap--narrow prose">
      <h2>What we cannot honestly claim yet</h2>
      <p>
        This started on {experiment.baseline.capturedAt}. Search results move slowly — a change
        takes weeks to settle, and a fair comparison needs a full month before it means anything.
        Anyone showing you dramatic results a few days after starting is showing you random
        movement and calling it progress.
      </p>
      <p>
        So there is exactly one honest claim on this page today: here is where we started, here
        is how we will measure it, and here is everything we have done. The next set of numbers
        goes up when the first month is done — whether or not they make us look good.
      </p>
      <p><a href="/changelog/">See the {entries.length} changes made so far →</a></p>
    </div>
  </section>

  <CtaBand
    heading="Want the same thing run on your site?"
    body="It starts the same way every time: your starting numbers written down, a group of pages left alone to compare against, and an agreed timescale."
  />
</Base>

<style>
  .head h1 { margin-block: 1rem 1.2rem; max-width: 16ch; }
  table { min-width: 640px; border-top: 1px solid var(--line-strong); }
  .num { text-align: right; font-variant-numeric: tabular-nums; font-family: var(--font-mono); font-size: 0.82rem; }
  th[scope="row"] { font-weight: 500; }
  .src { margin-top: 1rem; font-size: 0.7rem; }
  .speed h2 { margin-block: 0.8rem 1rem; }
  .speed .lede { margin-bottom: 2.5rem; }
  .shipped .k { font-size: 0.68rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-muted); line-height: 1.4; }
  .shipped .v { font-size: var(--step-3); font-weight: 600; letter-spacing: -0.03em; margin: 0.5rem 0 0.35rem; font-variant-numeric: tabular-nums; }
  .shipped .v span { font-size: 0.45em; font-weight: 500; color: var(--text-muted); margin-left: 0.15rem; }
  .shipped .mono.muted { font-size: 0.68rem; line-height: 1.4; }
  .lighthouse { margin-top: 2rem; }
  .lighthouse table { min-width: 560px; border-top: 1px solid var(--line-strong); }
  .field-note { margin-top: 2.5rem; border-left: 3px solid var(--warn-text); background: var(--bg-soft); padding: 1.2rem 1.4rem; border-radius: 0 var(--radius-lg) var(--radius-lg) 0; max-width: 70ch; }
  .field-note p:nth-child(2) { margin-top: 0.7rem; }
  .field-note .mono { margin-top: 0.9rem; font-size: 0.7rem; }

  .method h2 { margin-block: 0.8rem 2rem; }
  .steps h3 { font-size: var(--step-1); margin-block: 0.4rem 0.6rem; }
  .steps p { font-size: var(--step--1); }
  .steps .n { color: var(--accent); font-weight: 600; letter-spacing: 0.1em; }
  .prose a { color: var(--accent); font-weight: 600; }
</style>
