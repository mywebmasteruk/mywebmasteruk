---
import Base from "~/layouts/Base.astro";
import Readout from "~/components/Readout.astro";
import CtaBand from "~/components/CtaBand.astro";
import experiment from "~/data/experiment.json";
import { getCollection } from "astro:content";
import { site } from "~/data/site";

const entries = (await getCollection("changelog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const fmt = new Intl.NumberFormat("en-GB");
const opps = experiment.topOpportunities;
---
<Base
  title="Proof & method — the experiment running on this domain"
  description="The measurement method behind Autopilot: the published baseline, the holdout design, the measurement window, and what gets reported including the losses."
  breadcrumbs={[{ name: "Proof", href: "/proof/" }]}
>
  <section class="section head">
    <div class="wrap">
      <p class="label">Proof &amp; method</p>
      <h1>The experiment is this website.</h1>
      <p class="lede">
        It would be a bit rich to sell a service that improves websites automatically, using a
        website we polished by hand. So this one is the guinea pig: same system, same rules, same
        public record — and we posted the starting numbers before doing any of the work.
      </p>
    </div>
  </section>

  <section class="wrap">
    <Readout />
  </section>

  <section class="section">
    <div class="wrap wrap--narrow prose">
      <h2>What the baseline says</h2>
      <p>
        In the 90 days to {experiment.baseline.window.endDate}, this website appeared in Google
        {fmt.format(experiment.baseline.impressions)} times and got
        {experiment.baseline.clicks} visits from it. That is roughly one visit for every seven
        hundred times we were shown, sitting on average around page four.
      </p>
      <p>
        Sitting around page four means Google knows the site exists and thinks it is roughly
        relevant, but nobody scrolls that far. Those eighteen thousand appearances are real
        people looking for something we could have helped with. That is a better starting point
        than no interest at all, because the demand is already there — it just is not being met.
      </p>

      <h2>The demand that is already arriving</h2>
      <p>
        These are the searches where this site gets shown but almost never clicked. Look at what
        they have in common: they are all describing the exact problem Autopilot exists to fix.
      </p>
    </div>
  </section>

  <section class="wrap">
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th scope="col">What people searched for</th>
            <th scope="col">Times shown</th>
            <th scope="col">Visits</th>
            <th scope="col">Click rate</th>
            <th scope="col">Typical spot</th>
          </tr>
        </thead>
        <tbody>
          {opps.map((o) => (
            <tr>
              <th scope="row">{o.query}</th>
              <td class="num">{fmt.format(o.impressions)}</td>
              <td class="num">{o.clicks}</td>
              <td class="num">{o.ctr}%</td>
              <td class="num">{o.position}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mono muted src">
      Source: Google's own search figures for this website, {experiment.baseline.window.startDate}
      to {experiment.baseline.window.endDate}.
    </p>
  </section>

  <section class="section method invert">
    <div class="wrap">
      <p class="label">Method</p>
      <h2>How we decide something actually worked</h2>
      <div class="grid grid--2 steps">
        <div class="card">
          <p class="mono n">01</p>
          <h3>Post the starting numbers first</h3>
          <p class="muted">Written down before a single change is made. That removes the oldest trick in the trade: quietly choosing a flattering start date once you already know how it turned out.</p>
        </div>
        <div class="card">
          <p class="mono n">02</p>
          <h3>Leave some pages alone</h3>
          <p class="muted">Similar pages are split at random into two groups, and one group is deliberately never improved. That genuinely costs something — and it is what buys you a number you can trust.</p>
        </div>
        <div class="card">
          <p class="mono n">03</p>
          <h3>Agree the timescale up front</h3>
          <p class="muted">28 days, decided in advance, with the page left untouched throughout. Anything shorter is measuring noise. Anything decided afterwards is measuring wishful thinking.</p>
        </div>
        <div class="card">
          <p class="mono n">04</p>
          <h3>Report the difference, losses and all</h3>
          <p class="muted">How the improved pages moved, minus how the untouched ones moved. Anything that lost gets put back, and published just as visibly as anything that won.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap wrap--narrow prose">
      <h2>What we cannot honestly claim yet</h2>
      <p>
        This started on {experiment.baseline.capturedAt}. Search results move slowly — a change
        takes weeks to settle, and a fair comparison needs a full month before it means anything.
        Anyone showing you dramatic results a few days after starting is showing you random
        movement and calling it progress.
      </p>
      <p>
        So there is exactly one honest claim on this page today: here is where we started, here
        is how we will measure it, and here is everything we have done. The next set of numbers
        goes up when the first month is done — whether or not they make us look good.
      </p>
      <p><a href="/changelog/">See the {entries.length} changes made so far →</a></p>
    </div>
  </section>

  <CtaBand
    heading="Want the same thing run on your site?"
    body="It starts the same way every time: your starting numbers written down, a group of pages left alone to compare against, and an agreed timescale."
  />
</Base>

<style>
  .head h1 { margin-block: 1rem 1.2rem; max-width: 16ch; }
  table { min-width: 640px; border-top: 1px solid var(--line-strong); }
  .num { text-align: right; font-variant-numeric: tabular-nums; font-family: var(--font-mono); font-size: 0.82rem; }
  th[scope="row"] { font-weight: 500; }
  .src { margin-top: 1rem; font-size: 0.7rem; }
  .method h2 { margin-block: 0.8rem 2rem; }
  .steps h3 { font-size: var(--step-1); margin-block: 0.4rem 0.6rem; }
  .steps p { font-size: var(--step--1); }
  .steps .n { color: var(--accent); font-weight: 600; letter-spacing: 0.1em; }
  .prose a { color: var(--accent); font-weight: 600; }
</style>
