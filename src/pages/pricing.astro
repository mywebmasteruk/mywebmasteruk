---
import Base from "~/layouts/Base.astro";
import Faq from "~/components/Faq.astro";
import CtaBand from "~/components/CtaBand.astro";
import { getCollection } from "astro:content";
import { site } from "~/data/site";
import { faqNode, serviceNode } from "~/lib/schema";

const plans = (await getCollection("plans")).sort((a, b) => a.data.order - b.data.order);
const money = new Intl.NumberFormat("en-GB");


const faqs = [
  {
    q: "Am I tied into a contract?",
    a: "Watch and Apply are month to month, cancel whenever you like. Compound has a three-month minimum for one reason only: comparing against untouched pages needs a full month to run and a little longer to report on. Charging you for less than that would be selling you a number nobody could trust.",
  },
  {
    q: "What happens to the work if I leave?",
    a: "You keep all of it. The site and everything we improved on it are yours and always were. Nothing sits inside some system of ours that you would lose access to. And if you would rather have your original site back exactly as it was before we started, we kept a copy of that from day one and will put it back for you.",
  },
  {
    q: "Do you work on websites you did not build?",
    a: "Yes, most of the time. What matters is that changes to your site can be tracked and undone. If your site was made with a website builder that keeps no history, the first job is usually moving it somewhere changes can be measured and reversed — which is worth doing whoever ends up looking after it.",
  },
  {
    q: "How does the guarantee work?",
    a: "On Compound we improve one group of pages and deliberately leave a similar group alone. If the untouched pages do better than ours two months running, that month is refunded. We can only offer this because leaving pages alone produces a number that settles the argument, instead of a graph that can be spun either way.",
  },
  {
    q: "What is not included?",
    a: "Hosting, domain names, paid advertising and full redesigns are not part of it. Autopilot keeps improving the website you already have. If your site is fundamentally wrong for your business, it needs rebuilding first — and we will tell you that rather than take the monthly fee.",
  },
];

const schema = [
  serviceNode({
    name: site.product,
    description: site.description,
    url: `${site.url}/pricing/`,
    offers: plans.map((p) => ({
      name: p.data.name,
      price: p.data.priceMonthly,
      currency: p.data.currency,
      description: p.data.tagline,
    })),
  }),
  faqNode(faqs),
];
---
<Base
  title="Pricing — three levels of autonomy | MyWebMaster"
  description="Autopilot pricing: report-only from £149 a month, unattended safe fixes from £449, and holdout-proven content and conversion work from £1,200. No lock-in."
  breadcrumbs={[{ name: "Pricing", href: "/pricing/" }]}
  schema={schema}
>
  <section class="section head">
    <div class="wrap">
      <p class="label">Pricing</p>
      <h1>You are buying autonomy, one level at a time.</h1>
      <p class="lede">
        What changes between them is how much we are allowed to do without asking you first —
        not how many features you unlock. Everyone gets measured the same way.
      </p>
    </div>
  </section>

  <section class="wrap">
    <div class="grid grid--3 plans">
      {plans.map((p) => (
        <article class:list={["card", "plan", p.data.featured && "plan--featured"]}>
          {p.data.featured && <p class="mono flag">Most chosen</p>}
          <h2>{p.data.name}</h2>
          <p class="price">
            {p.data.priceMonthly ? <>£{money.format(p.data.priceMonthly)}<span class="per mono">/mo</span></> : "Talk to us"}
          </p>
          {p.data.priceNote && <p class="mono muted note">{p.data.priceNote}</p>}
          <p class="tagline">{p.data.tagline}</p>

          <dl class="spec mono">
            <div><dt>Autonomy</dt><dd>{p.data.autonomy}</dd></div>
            <div><dt>Cadence</dt><dd>{p.data.cadence}</dd></div>
          </dl>

          <p class="best"><span class="mono muted">Best for · </span>{p.data.bestFor}</p>

          <ul class="includes">
            {p.data.includes.map((i) => <li>{i}</li>)}
          </ul>
          {p.data.excludes.length > 0 && (
            <ul class="excludes">
              {p.data.excludes.map((i) => <li>{i}</li>)}
            </ul>
          )}

          <a
            class:list={["btn", p.data.featured ? "btn--primary" : "btn--ghost"]}
            href={p.data.checkoutUrl ?? "/contact/"}
            rel={p.data.checkoutUrl ? "noopener" : undefined}
          >
            {p.data.cta}
          </a>
          {p.data.checkoutUrl && (
            <p class="mono muted secure">Secure checkout by Stripe · cancel any time</p>
          )}
        </article>
      ))}
    </div>
    <p class="vat mono muted">
      Prices exclude VAT. One website per plan. Got several? Ask us and we will work something out.
    </p>
  </section>

  <section class="section compare">
    <div class="wrap wrap--narrow prose">
      <h2>Two kinds of proof, at two different speeds</h2>
      <p>
        Google is slow. A change takes weeks to settle, and a fair comparison needs a full month
        before it means anything — which is an uncomfortably long time to be paying for something
        and seeing nothing happen.
      </p>
      <p>
        So we deliberately order the work to give you both. <strong>Fast proof</strong> comes
        first: page speed, broken links, error pages, and whether AI assistants can even read
        you. All of that shifts in the first week, and you can check it yourself without taking
        our word for anything.
      </p>
      <p>
        <strong>Slow proof</strong> builds underneath it: where you actually rank and how many
        people get in touch, measured against the pages we left alone, reported once the month
        is up.
      </p>
      <p>
        If someone can only offer you the slow kind, they are asking you to fund a month of
        faith. If they only offer the fast kind, they are showing you activity and calling it
        results.
      </p>

      <h2>How to choose</h2>
      <p>
        <strong>Take Watch</strong> if you already have someone who looks after the site, and
        the real problem is knowing what to fix first. We tell you exactly what to change; your
        person makes the change.
      </p>
      <p>
        <strong>Take Apply</strong> if the list of small jobs never actually gets done. The
        mechanical half simply stops being your problem, and you still approve anything that
        changes what your website says.
      </p>
      <p>
        <strong>Take Compound</strong> if being found and getting enquiries is a real part of
        your income. It is the only one where we leave pages alone to compare against — which
        makes it the only one where "did this work?" has a measured answer rather than an opinion.
      </p>
    </div>
  </section>

  <Faq faqs={faqs} title="Before you buy" />
  <CtaBand
    heading="Not sure which tier fits?"
    body="We run one free scan of your site and send the ranked fix list. It is the same output Watch produces, and it usually makes the choice obvious."
  />
</Base>

<style>
  .head h1 { margin-block: 1rem 1.2rem; max-width: 18ch; }
  .plans { align-items: start; }
  .plan { display: flex; flex-direction: column; height: 100%; }
  .plan--featured { box-shadow: 0 0 0 1px var(--accent-graphic); }
  .flag { color: var(--accent); font-size: 0.68rem; letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 0.5rem; }
  .plan h2 { font-size: var(--step-1); }
  .price { font-size: var(--step-4); font-weight: 600; letter-spacing: -0.035em; margin-top: 0.4rem; }
  .per { font-size: 0.9rem; color: var(--text-muted); font-weight: 400; margin-left: 0.25rem; }
  .note { font-size: 0.7rem; margin-top: 0.2rem; }
  .tagline { margin-top: 1rem; font-size: var(--step--1); }
  .spec { display: flex; gap: 1.5rem; margin-top: 1.2rem; padding-block: 0.9rem; border-block: 1px solid var(--line); font-size: 0.68rem; }
  .spec dt { text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted); }
  .spec dd { margin: 0.25rem 0 0; }
  .best { margin-top: 1rem; font-size: var(--step--1); color: var(--text-muted); }
  .includes, .excludes { list-style: none; padding: 0; margin-top: 1.2rem; font-size: var(--step--1); flex: 1; }
  .includes li, .excludes li { padding-left: 1.4rem; position: relative; }
  .includes li + li, .excludes li + li { margin-top: 0.6rem; }
  .includes li::before { content: "✓"; position: absolute; left: 0; color: var(--ok-text); font-weight: 700; }
  .excludes { flex: 0; margin-top: 0.6rem; color: var(--text-muted); }
  .excludes li::before { content: "—"; position: absolute; left: 0; }
  .plan .btn { margin-top: 1.6rem; justify-content: center; }
  .secure { font-size: 0.65rem; margin-top: 0.6rem; text-align: center; }
  .vat { margin-top: 1.5rem; font-size: 0.7rem; }
  .compare h2 { font-size: var(--step-3); margin-bottom: 1.2rem; }
  .compare p + p { margin-top: 1rem; }
</style>
