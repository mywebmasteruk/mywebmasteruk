---
import Base from "~/layouts/Base.astro";
import Readout from "~/components/Readout.astro";
import Faq from "~/components/Faq.astro";
import CtaBand from "~/components/CtaBand.astro";
import { getCollection } from "astro:content";
import experiment from "~/data/experiment.json";
import { evidence } from "~/lib/evidence";
import { site } from "~/data/site";
import { faqNode, serviceNode } from "~/lib/schema";
import experiment from "~/data/experiment.json";
import { evidence } from "~/lib/evidence";

const plans = (await getCollection("plans")).sort((a, b) => a.data.order - b.data.order);
const money = new Intl.NumberFormat("en-GB");

const caps = await getCollection("capabilities");
/** Only what the running system can actually carry out today. */
const liveCaps = caps.filter((c) => c.data.status !== "planned");
const counts = {
  auto: liveCaps.filter((c) => c.data.autonomy === "auto").length,
  notify: liveCaps.filter((c) => c.data.autonomy === "notify").length,
  never: liveCaps.filter((c) => c.data.autonomy === "never").length,
};

/** The same field /proof/ reads. No surface describes the method independently. */
const design = experiment.design ?? { kind: "none", holdout: null, note: "" };
const controlled = evidence.controlled;

const faqs = [
  {
    q: "What does Autopilot actually do?",
    a: "It looks at how your website is really performing — what people search for, what they click, how fast your pages load, what is broken — and then it improves things, a few at a time. It checks every day, makes changes once a week, and tells you whether each change worked by comparing it against pages we deliberately left alone.",
  },
  {
    q: "Will it change my site without asking me?",
    a: `Yes — that is the point of it, and here is exactly how far it goes. ${counts.auto} safe, mechanical things are fixed and appear in your next report: broken links, page speed, pictures that make the page jump about. ${counts.notify} things change your actual words — the headline Google shows, a new answer, a new page — and those are done and emailed to you the same day, with the old version one click away. ${counts.never} things are never touched at all, by anyone automatic: your prices, your promises, your legal wording, and the settings that control whether Google shows your site.`,
  },
  {
    q: "How do I know it actually worked?",
    a: controlled
      ? `Because we leave ${evidence.holdout.length} pages alone on purpose — chosen before any change was made, and never touched since. Both groups go through the same Google updates, the same quiet months and the same competition, so whatever difference opens up between them is the bit we caused.${evidence.hasResult ? " We report it monthly, including the months where our changes lost." : " The first comparison window has not closed yet, so there is no number to show you."}`
      : `Honestly: not with certainty yet. ${design.note} We publish every change and what happened after it, including the ones that lost, but a good month for your whole trade would look like our work — and we would rather say that than hand you a confident number we cannot stand behind.`,
  },
  {
    q: "Why only change things once a week if you check every day?",
    a: "Because Google is slow to respond. It takes weeks for a change to settle into the search results, and the data itself arrives a few days late. If we changed pages every day we would be reacting to random wobbles, and we would never know which change caused what. Watching daily but changing weekly is what makes the answer readable.",
  },
  {
    q: "What if a change makes things worse?",
    a: "We put it back, and we say so publicly. Every change is made separately and dated, so undoing any single one takes seconds and does not disturb anything else. On the Compound plan, if the pages we left alone beat the pages we worked on two months running, that month is refunded.",
  },
  {
    q: "Could this get me in trouble with Google?",
    a: "It is built specifically to avoid it. What Google punishes is churning out piles of low-quality pages to hoover up traffic. Autopilot does the opposite: it works on the pages you already have and makes them faster, clearer and more useful. Publishing a brand new page always needs your approval, precisely because that is where the line sits.",
  },
];

const schema = [
  serviceNode({
    name: site.product,
    description: site.description,
    url: `${site.url}/`,
    offers: plans.map((p) => ({
      name: p.data.name,
      price: p.data.priceMonthly,
      currency: p.data.currency,
      description: p.data.tagline,
    })),
  }),
  faqNode(faqs),
];
---
<Base
  title="Autopilot — the website that optimises itself | MyWebMaster"
  description="A supervised AI system that measures your website daily, ships small evidence-led improvements, and proves the lift against a control group. Live on this domain."
  schema={schema}
>
  <section class="hero invert">
    <div class="wrap">
      <p class="label">Autopilot · running live on this domain</p>
      <h1>Most websites are finished on the day they launch. This one isn't.</h1>
      <p class="lede">
        Autopilot looks at how your website is really doing every single day, makes a few small
        improvements every week, and proves they worked by comparing against pages it was told to
        leave alone. It is running on mywebmaster.co.uk right now, and every change it makes is
        published for anyone to read.
      </p>
      <div class="actions">
        <a class="btn btn--primary" href="/how-it-works/">See how the loop works</a>
        <a class="btn btn--ghost" href="/changelog/">See what it changed today</a>
      </div>
    </div>
  </section>

  <section class="section proof-strip">
    <div class="wrap">
      <div class="proof-head">
        <div>
          <p class="label">The experiment</p>
          <h2>We started by publishing how bad it was.</h2>
        </div>
        <p class="lede">
          Before Autopilot changed a thing, this website was shown in Google
          {new Intl.NumberFormat("en-GB").format(experiment.baseline.impressions)} times in 90
          days, and got {experiment.baseline.clicks} visits out of it. That is the honest
          starting line, and everything from here is measured against it.
        </p>
      </div>
      <Readout />
      <p class="footnote mono muted">
        Anyone selling you search marketing can show you a graph that goes up. Far fewer will
        show you where they started, in public, before doing any of the work.
        <a href="/proof/">How we measure →</a>
      </p>
    </div>
  </section>

  <section class="section loop-section">
    <div class="wrap">
      <p class="label">The loop</p>
      <h2>Measure. Decide. Ship. Prove. Repeat.</h2>
      <ol class="grid grid--4 steps">
        <li class="card">
          <p class="mono step-n">01</p>
          <h3>Measure</h3>
          <p class="muted">
            Every day we check your Google search figures, your visitor numbers, every page on
            the site, how fast it really loads for people, and which AI assistants have been
            reading you.
          </p>
        </li>
        <li class="card">
          <p class="mono step-n">02</p>
          <h3>Decide</h3>
          <p class="muted">
            We sort what we find by how much it is likely to be worth, not by how easy it is.
            Each change has to come with a written prediction before it is allowed anywhere
            near your site.
          </p>
        </li>
        <li class="card">
          <p class="mono step-n">03</p>
          <h3>Ship</h3>
          <p class="muted">
            Changes go out one at a time, each on its own, each undoable on its own. The safe
            mechanical ones we simply do. Anything involving your words waits for you to say yes.
          </p>
        </li>
        <li class="card">
          <p class="mono step-n">04</p>
          <h3>Prove</h3>
          <p class="muted">
            We then leave that page completely alone for 28 days and compare it with the pages
            we never touched. What worked stays, what did not is put back, and we publish both.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <section class="section bounds">
    <div class="wrap">
      <div class="bounds-head">
        <div>
          <p class="label">Autonomy, bounded</p>
          <h2>The interesting question is not what it can change. It's what it can't.</h2>
        </div>
        <p class="lede">
          Letting something automatic change your live website is only sensible if the limits
          are written down, enforced by the system itself, and published where you can hold us
          to them. Ours is a table anyone can read.
        </p>
      </div>
      <div class="grid grid--3 tiers">
        <div class="card tier tier--auto">
          <p class="mono count">{counts.auto}</p>
          <h3>Ships unattended</h3>
          <p class="muted">
            Mechanical, instantly undoable, and involving no judgement about your business:
            broken links, page speed, pictures that make the page jump, and the hidden labels
            search engines read.
          </p>
        </div>
        <div class="card tier tier--notify">
          <p class="mono count">{counts.notify}</p>
          <h3>Done, then you are told</h3>
          <p class="muted">
            Anything that changes what your business says: the headline Google shows, the
            wording on the page, new questions answered, new pages, layout tests. It ships,
            and the email showing you the old and new wording arrives the same day.
          </p>
        </div>
        <div class="card tier tier--never">
          <p class="mono count">{counts.never}</p>
          <h3>Never touched</h3>
          <p class="muted">
            Your prices, your guarantees, your legal wording, claims about your business, and
            the settings that decide whether Google shows your site at all. Sealed off entirely.
          </p>
        </div>
      </div>
      <p class="footnote"><a href="/what-it-changes/">Read the full change taxonomy →</a></p>
    </div>
  </section>

  <section class="section diff">
    <div class="wrap">
      <p class="label">Structurally different</p>
      <h2>Three things that are true here and not elsewhere.</h2>
      <div class="grid grid--3 diffs">
        <article class="card">
          <p class="mono diff-n">01</p>
          <h3>We change your website, not a layer on top of it</h3>
          <p class="muted">
            Most tools of this kind do not really change your site. They bolt a script onto it
            that rewrites the page while a visitor is looking at it. The problem is that
            ChatGPT, Claude and Perplexity do not run those scripts — a study of over 500
            million of their visits found they never do.
          </p>
          <p class="muted">
            So those "get found by AI" fixes are invisible to the very things they are sold for.
            We change the site itself, so everyone sees the improvement: people, Google, and
            every AI assistant.
          </p>
          <a class="mono more" href="/answers/do-ai-crawlers-execute-javascript/">The evidence →</a>
        </article>
        <article class="card">
          <p class="mono diff-n">02</p>
          <h3>You keep everything if you leave</h3>
          <p class="muted">
            With the bolt-on tools, the day you stop paying, the script stops loading and your
            pages quietly go back to how they were. You were renting improvements to your own
            website.
          </p>
          <p class="muted">
            Here, the improvements are part of your site. Cancelling stops us doing anything
            more; it takes nothing away. There is no switch on our end that turns your website
            back off.
          </p>
          <a class="mono more" href="/answers/what-happens-if-i-cancel/">What cancelling does →</a>
        </article>
        <article class="card">
          <p class="mono diff-n">03</p>
          <h3>We publish the failures too</h3>
          <p class="muted">
            Every change is written down along with what we predicted it would do — before we
            made it. That way it can be judged against what we actually expected, rather than
            against a story invented afterwards.
          </p>
          <p class="muted">
            The ones we had to undo are listed just as prominently as the wins. A list with
            nothing but successes on it tells you the list has been tidied.
          </p>
          <a class="mono more" href="/changelog/">Read the list →</a>
        </article>
      </div>
    </div>
  </section>

  <section class="section plans-section">
    <div class="wrap">
      <p class="label">Plans</p>
      <h2>Three levels of trust.</h2>
      <p class="lede">
        Start wherever you feel comfortable. Most people begin on Watch, spend a month seeing
        whether they agree with what we find, and then move up.
      </p>
      <div class="grid grid--3 plan-grid">
        {plans.map((p) => (
          <article class:list={["card", "plan", p.data.featured && "plan--featured"]}>
            {p.data.featured && <p class="mono flag">Most chosen</p>}
            <h3>{p.data.name}</h3>
            <p class="price">
              {p.data.priceMonthly ? <>£{money.format(p.data.priceMonthly)}<span class="mono per">/mo</span></> : "Talk to us"}
            </p>
            <p class="muted plan-tag">{p.data.tagline}</p>
            <a
              class:list={["btn", p.data.featured ? "btn--primary" : "btn--ghost"]}
              href={p.data.checkoutUrl ?? "/pricing/"}
              rel={p.data.checkoutUrl ? "noopener" : undefined}
            >
              {p.data.cta}
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Faq faqs={faqs} title="What people ask before they let us near their site" />
  <CtaBand />
</Base>

<style>
  .hero { padding-block: clamp(4rem, 2.5rem + 7vw, 9rem) clamp(3.5rem, 2rem + 6vw, 7rem); }
  .hero h1 { margin-block: 1.2rem 1.5rem; max-width: 17ch; }
  .hero .lede { max-width: 62ch; }
  .actions { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 2.2rem; }

  .proof-head, .bounds-head { display: grid; gap: 1.25rem; align-items: end; margin-bottom: 2.5rem; }
  @media (min-width: 900px) { .proof-head, .bounds-head { grid-template-columns: 1fr 1fr; gap: 3rem; } }
  .proof-head h2, .bounds-head h2 { max-width: 18ch; margin-top: 0.8rem; }
  .footnote { margin-top: 1.5rem; font-size: var(--step--1); }
  .footnote a { color: var(--accent); font-weight: 600; text-decoration: none; }
  .footnote a:hover { text-decoration: underline; }

  .loop-section h2 { margin-block: 0.8rem 2.5rem; max-width: 22ch; }
  .steps { list-style: none; padding: 0; }
  .steps h3 { margin-block: 0.5rem 0.6rem; font-size: var(--step-1); }
  .steps p { font-size: var(--step--1); }
  .step-n { color: var(--accent); font-weight: 600; letter-spacing: 0.1em; }

  .tiers .tier { border-top: 3px solid var(--line-strong); }
  .tier--auto { border-top-color: var(--ok-text); }
  .tier--notify { border-top-color: var(--warn-text); }
  .tier--never { border-top-color: var(--bad-text); }
  .tier .count { font-size: var(--step-3); font-weight: 600; letter-spacing: -0.02em; }
  .tier h3 { margin-block: 0.2rem 0.6rem; font-size: var(--step-1); }
  .tier p.muted { font-size: var(--step--1); }

  .diff h2 { margin-block: 0.8rem 2.5rem; max-width: 20ch; }
  .diffs h3 { font-size: var(--step-1); margin-block: 0.5rem 0.7rem; }
  .diffs p { font-size: var(--step--1); }
  .diffs p + p { margin-top: 0.8rem; }
  .diff-n { color: var(--accent); font-weight: 600; letter-spacing: 0.1em; }
  .diffs .more { display: inline-block; margin-top: 1rem; color: var(--accent); font-weight: 600; font-size: 0.72rem; text-decoration: none; }
  .diffs .more:hover { text-decoration: underline; }

  .plans-section h2 { margin-block: 0.8rem 0.8rem; }
  .plan-grid { margin-top: 2.5rem; align-items: start; }
  .plan { display: flex; flex-direction: column; gap: 0.6rem; height: 100%; }
  .plan--featured { border-color: var(--line-strong); box-shadow: 0 0 0 1px var(--accent-graphic); }
  .flag { color: var(--accent); font-size: 0.68rem; letter-spacing: 0.12em; text-transform: uppercase; }
  .plan h3 { font-size: var(--step-1); }
  .price { font-size: var(--step-3); font-weight: 600; letter-spacing: -0.03em; }
  .per { font-size: 0.85rem; color: var(--text-muted); font-weight: 400; margin-left: 0.2rem; }
  .plan-tag { font-size: var(--step--1); flex: 1; }
  .plan .btn { align-self: flex-start; margin-top: 0.5rem; }
</style>
