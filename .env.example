# Search Console property. Domain properties cover every subdomain and protocol.
GSC_PROPERTY=sc-domain:mywebmaster.co.uk

# GA4 numeric property id — GA4 → Admin → Property Settings.
# Requires the Analytics Data API enabled on the service account's Cloud project.
GA4_PROPERTY_ID=

# Service-account key location. Defaults to ~/.config/gsc/service-account.json.
# Never commit this file.
GOOGLE_APPLICATION_CREDENTIALS=

# Set to 1 to stop all autonomous activity. `ops/HALT` does the same thing.
AUTOPILOT_HALT=

# --- AI provider (these become the admin settings screen) -------------------
AI_PROVIDER=anthropic
AI_MODEL=claude-opus-5
AI_EFFORT=high              # low | medium | high | xhigh | max
AI_MAX_TOKENS=16000
AI_DRAFTING=on              # "off" keeps the loop fully deterministic
AI_BRAND_VOICE=             # per-client voice rules, agreed at onboarding
ANTHROPIC_API_KEY=

# --- Public speed figures ---------------------------------------------------
# Free key from Google Cloud with the PageSpeed Insights API enabled.
# Without it the keyless quota (a few runs a day) is used instead.
PAGESPEED_API_KEY=

# --- Analytics --------------------------------------------------------------
PUBLIC_GA4_ID=G-KJ60QDY7SQ

# --- Email (SMTP) -----------------------------------------------------------
# Used by the Stripe webhook and the weekly report. Port 465 uses implicit TLS,
# 587 upgrades with STARTTLS — getting this wrong causes a silent hang.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MyWebMaster <hello@mywebmaster.co.uk>"
REPLY_TO=
# Blind-copied on customer mail, and the recipient for internal alerts.
ADMIN_EMAIL=

# --- Stripe webhook ---------------------------------------------------------
# From Stripe → Developers → Webhooks, for the endpoint below.
STRIPE_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=

# --- Telling the customer ---------------------------------------------------
# The loop no longer asks permission, so this is what replaces it. Changes that
# alter words a visitor reads are always sent the same day; everything else is
# batched at this cadence: instant | daily | weekly.
NOTIFY_CADENCE=weekly
# Autonomy classes that always send immediately, whatever the cadence above.
NOTIFY_INSTANT=notify
# Where change notices go. Falls back to ADMIN_EMAIL during setup.
CUSTOMER_EMAIL=
# Set to "off" to stop sending. The queue still fills, so nothing is lost —
# it all goes out when this is turned back on.
NOTIFY=
# Signs the one-click "put it back" link in every notice. Without it the link is
# omitted rather than broken.
LINK_SIGNING_SECRET=
# Identifies the customer in that link. Their Stripe customer id.
CUSTOMER_REF=

# --- What the loop is allowed to write about --------------------------------
SITE_URL=https://mywebmaster.co.uk
SITE_DOMAIN=mywebmaster.co.uk
# Stops a new page being written about something this business does not do.
BUSINESS_DESCRIPTION=
