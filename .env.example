# Search Console property. Domain properties cover every subdomain and protocol.
GSC_PROPERTY=sc-domain:mywebmaster.co.uk

# GA4 numeric property id — GA4 → Admin → Property Settings.
# Requires the Analytics Data API enabled on the service account's Cloud project.
GA4_PROPERTY_ID=

# Service-account key location. Defaults to ~/.config/gsc/service-account.json.
# Never commit this file.
GOOGLE_APPLICATION_CREDENTIALS=

# Set to 1 to stop all autonomous activity. `ops/HALT` does the same thing.
AUTOPILOT_HALT=

# --- AI provider (these become the admin settings screen) -------------------
AI_PROVIDER=anthropic
AI_MODEL=claude-opus-5
AI_EFFORT=high              # low | medium | high | xhigh | max
AI_MAX_TOKENS=16000
AI_DRAFTING=on              # "off" keeps the loop fully deterministic
AI_BRAND_VOICE=             # per-client voice rules, agreed at onboarding
ANTHROPIC_API_KEY=
